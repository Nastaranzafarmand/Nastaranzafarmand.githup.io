<script>
  let currentLanguage = "fa";

  function toggleLanguage() {
    currentLanguage = currentLanguage === "fa" ? "en" : "fa";

    document.documentElement.lang = currentLanguage;
    document.documentElement.dir =
      currentLanguage === "fa" ? "rtl" : "ltr";

    document.body.dir =
      currentLanguage === "fa" ? "rtl" : "ltr";

    document.querySelectorAll("[data-fa]").forEach(element => {
      element.style.display =
        currentLanguage === "fa" ? "" : "none";
    });

    document.querySelectorAll("[data-en]").forEach(element => {
      element.style.display =
        currentLanguage === "en" ? "" : "none";
    });

    document.querySelector(".language-button").textContent =
      currentLanguage === "fa" ? "English" : "فارسی";
  }
</script>

